# Server Port (Local)
PORT=3005

# Optional: Custom Chrome executable path (Windows / Mac / Linux)
# CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Optional: Remote Cloud Chromium for Vercel Serverless (Browserless.io / Browserbase)
# BROWSERLESS_API_KEY=your_browserless_api_key_here
# BROWSER_WS_ENDPOINT=wss://chrome.browserless.io?token=your_key

# Optional: AI Reasoning Providers (Built-in Heuristic Planner works with 0 keys!)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GROQ_API_KEY=your_groq_api_key
